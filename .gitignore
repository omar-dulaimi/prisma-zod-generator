# Test scratch space
#
# `test-env-*/` is what tests/helpers/global-setup.ts sweeps around every run.
# `test-*-*` is deliberately broad and predates it - it will also swallow a
# source file named like `test-foo-bar.ts`, so name new fixtures carefully.
test-output/
test-env-*/
test-*-*
manual-*-*
debug-test
legacy-output
temp-schema-*.prisma
*.db
*.sqlite
*.sqlite3

# Test-generated Prisma config (writeConfig emits one next to the schema under test)
prisma.config.mjs
tests/multi-provider/schemas/*/prisma.config.mjs

# Test reports and logs
test-report.json
test-results.json
test-*.json
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dev-debug.log
logs/

# PZG Pro generated examples and outputs
# These packs write to a hardcoded path relative to cwd, so keep the rules even
# when the directories are absent.
examples/generated/
tests/contracts/
postgres/
wiremock/
pacts/
*.pact

